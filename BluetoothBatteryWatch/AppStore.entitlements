<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only for the Mac App Store build (scripts/release.sh <version> --app-store).
     The Homebrew build is not sandboxed and has no entitlements. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- IOBluetoothDevice lookups for the accessory names. -->
	<key>com.apple.security.device.bluetooth</key>
	<true/>
</dict>
</plist>
